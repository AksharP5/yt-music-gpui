#!/usr/bin/env python3
"""Sample Linux CPU and resident memory for the app and existing child processes."""
import json
import os
from pathlib import Path
import sys
import time

if len(sys.argv) not in (2, 3):
    sys.exit('Usage: bin/profile APP_PID [SECONDS]')
pid = int(sys.argv[1])
seconds = float(sys.argv[2]) if len(sys.argv) == 3 else 30
if seconds <= 0:
    sys.exit('SECONDS must be positive')

def processes(pid):
    yield pid
    children = {int(child) for task in Path(f'/proc/{pid}/task').iterdir() for child in (task / 'children').read_text().split()}
    for child in children:
        yield from processes(child)

def ticks(pid):
    fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
    return int(fields[11]) + int(fields[12])

initial = {p: ticks(p) for p in processes(pid)}
start = time.monotonic()
time.sleep(seconds)
elapsed = time.monotonic() - start
rows = []
for p, before in initial.items():
    try:
        cpu = 100 * (ticks(p) - before) / os.sysconf('SC_CLK_TCK') / elapsed
        memory = {line.split(':')[0]: int(line.split()[1]) for line in Path(f'/proc/{p}/smaps_rollup').read_text().splitlines() if line.startswith(('Rss:', 'Pss:'))}
        rows.append({'pid': p, 'name': Path(f'/proc/{p}/comm').read_text().strip(), 'cpu_percent_one_core': round(cpu, 2), 'rss_mib': round(memory['Rss'] / 1024, 1), 'pss_mib': round(memory['Pss'] / 1024, 1)})
    except FileNotFoundError:
        sys.exit('A sampled process exited; repeat while playback is steady.')
print(json.dumps({'seconds': round(elapsed, 2), 'processes': rows, 'total_cpu_percent_one_core': round(sum(r['cpu_percent_one_core'] for r in rows), 2), 'total_pss_mib': round(sum(r['pss_mib'] for r in rows), 1)}, indent=2))
