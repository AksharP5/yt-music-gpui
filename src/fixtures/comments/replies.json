{
  "onResponseReceivedEndpoints": [
    {
      "appendContinuationItemsAction": {
        "targetId": "comment-replies-item-top-comment",
        "continuationItems": [
          {
            "commentThreadRenderer": {
              "commentViewModel": {
                "commentViewModel": {
                  "commentKey": "reply-1-key",
                  "commentId": "reply-1"
                }
              },
              "replies": {
                "commentRepliesRenderer": {
                  "viewReplies": {
                    "buttonRenderer": {
                      "text": {
                        "simpleText": "1 reply"
                      }
                    }
                  },
                  "subThreads": [
                    {
                      "commentThreadRenderer": {
                        "commentViewModel": {
                          "commentViewModel": {
                            "commentKey": "nested-key",
                            "commentId": "nested"
                          }
                        },
                        "replies": {
                          "commentRepliesRenderer": {
                            "viewReplies": {
                              "buttonRenderer": {
                                "text": {
                                  "simpleText": "Show more replies"
                                }
                              }
                            },
                            "subThreads": [
                              {
                                "continuationItemRenderer": {
                                  "button": {
                                    "buttonRenderer": {
                                      "command": {
                                        "continuationCommand": {
                                          "token": "nested-tail"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "continuationItemRenderer": {
              "trigger": "CONTINUATION_TRIGGER_ON_ITEM_SHOWN",
              "continuationEndpoint": {
                "continuationCommand": {
                  "token": "replies-page-2"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "frameworkUpdates": {
