{
  "onResponseReceivedEndpoints": [
    {
      "reloadContinuationItemsCommand": {
        "targetId": "video-id",
        "continuationItems": [
          {
            "commentsHeaderRenderer": {
              "countText": {
                "runs": [
                  {
                    "text": "1,234"
                  },
                  {
                    "text": " Comments"
                  }
                ]
              },
              "sortMenu": {
                "sortFilterSubMenuRenderer": {
                  "subMenuItems": [
                    {
                      "title": "Top",
                      "selected": true,
                      "continuation": {
                        "reloadContinuationData": {
                          "continuation": "top-sort"
                        }
                      }
                    },
                    {
                      "title": "Newest",
                      "selected": false,
                      "continuation": {
                        "reloadContinuationData": {
                          "continuation": "new-sort"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "reloadContinuationItemsCommand": {
        "targetId": "comments-section",
        "continuationItems": [
          {
            "commentThreadRenderer": {
              "commentViewModel": {
                "commentViewModel": {
                  "commentKey": "top-comment-key",
                  "commentId": "top-comment",
                  "pinnedText": "Pinned by @artist"
                }
              },
              "replies": {
                "commentRepliesRenderer": {
                  "viewReplies": {
                    "buttonRenderer": {
                      "text": {
                        "runs": [
                          {
                            "text": "2 replies"
                          }
                        ]
                      }
                    }
                  },
                  "subThreads": [
                    {
                      "continuationItemRenderer": {
                        "trigger": "CONTINUATION_TRIGGER_ON_ITEM_SHOWN",
                        "continuationEndpoint": {
                          "continuationCommand": {
                            "token": "replies-page"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "commentThreadRenderer": {
              "commentViewModel": {
                "commentViewModel": {
                  "commentKey": "second-comment-key",
                  "commentId": "second-comment"
                }
              }
            }
          },
          {
            "continuationItemRenderer": {
              "trigger": "CONTINUATION_TRIGGER_ON_ITEM_SHOWN",
              "continuationEndpoint": {
                "continuationCommand": {
                  "token": "comments-page-2"
                }
              }
            }
          }
        ]
      }
    }
