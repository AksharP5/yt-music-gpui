pkgname=yt-music-gpui
pkgver=0.1.0
pkgrel=1
pkgdesc='Native YouTube Music client built with GPUI'
arch=('x86_64')
url='https://github.com/AksharP5/yt-music-gpui'
license=('MIT' 'Apache-2.0')
depends=('libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-driver' 'mpv' 'yt-dlp')
makedepends=('rust' 'pkgconf')
optdepends=('mpv-mpris: desktop media controls')

build() {
  cd "$startdir/.."
  cargo build --release --locked --jobs "${CARGO_BUILD_JOBS:-2}"
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/yt-music-gpui "$pkgdir/usr/bin/yt-music-gpui"
  install -Dm644 packaging/yt-music-gpui.desktop "$pkgdir/usr/share/applications/yt-music-gpui.desktop"
  install -Dm644 packaging/yt-music-gpui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/yt-music-gpui.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
